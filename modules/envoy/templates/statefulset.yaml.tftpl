---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: tailscale-egress
  labels:
    app: tailscale-egress
    proxy: envoy
spec:
  replicas: 1
  selector:
    matchLabels:
      app: tailscale-egress
  serviceName: tailscale-egress
  template:
    metadata:
      labels:
        app: tailscale-egress
        proxy: envoy
    spec:
%{ if anytrue([for tailnet in tailnets : tailnet.use_k8s_secret]) ~}
      serviceAccountName: tailscale-egress
%{ endif ~}
      terminationGracePeriodSeconds: 30
      containers:
        - name: envoy
          image: ${container_registry}/envoyproxy/envoy-distroless:v1.34-latest
          volumeMounts:
            - name: envoy-config
              mountPath: /etc/envoy
              readOnly: true
          ports:
%{ for tailnet_index, tailnet in tailnets ~}
%{ for service_index, service in tailnet.services ~}
            - name: p${10000 + (tailnet_index * 1000) + service_index}-${lower(service.protocol)}
              containerPort: ${10000 + (tailnet_index * 1000) + service_index}
              protocol: ${upper(service.protocol)}
%{ endfor ~}
%{ endfor ~}
%{ for index, tailnet in tailnets ~}
        - name: tailscale-${tailnet.tailnet_name}
          image: ${container_registry}/tailscale/tailscale:stable
          command: ['/bin/sh', '-c']
          args:
            - >-
                export TS_HOSTNAME=$(hostname)-${tailnet.tailnet_name}-$VES_IO_SITENAME;
                /usr/local/bin/containerboot
          volumeMounts:
            - name: var-run-${tailnet.tailnet_name}
              mountPath: /var/run
          env:
            - name: TS_USERSPACE
              value: 'true'
            - name: TS_ACCEPT_DNS
              value: 'false'
            - name: TS_EXTRA_ARGS
              value: --shields-up%{ if tailnet.tailnet_advertise_tags != null && tailnet.tailnet_advertise_tags != "" } --advertise-tags=${tailnet.tailnet_advertise_tags}%{ endif }
            - name: TS_OUTBOUND_HTTP_PROXY_LISTEN
              value: 'localhost:${10550 + index}'
            - name: TS_KUBE_SECRET
              value: ''
%{ if tailnet.use_k8s_secret ~}
            - name: TS_AUTHKEY
              valueFrom:
                secretKeyRef:
                  name: tailscale-auth-${tailnet.tailnet_name}
                  key: TS_AUTHKEY
%{ else ~}
            - name: TS_AUTHKEY
              value: '${tailnet.tailnet_key}'
%{ endif ~}
%{ endfor ~}
      volumes:
        - name: envoy-config
          configMap:
            name: tailscale-egress-envoy
%{ for tailnet in tailnets ~}
        - name: var-run-${tailnet.tailnet_name}
          emptyDir: {}
%{ endfor ~}
