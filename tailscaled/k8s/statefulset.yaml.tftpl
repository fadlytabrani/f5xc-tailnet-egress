---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: tailscale-egress
  labels:
    app: tailscale-egress
spec:
  replicas: 1
  selector:
    matchLabels:
      app: tailscale-egress
  serviceName: tailscale-egress
  template:
    metadata:
      labels:
        app: tailscale-egress
    spec:
      containers:
%{ for index, tailnet in tailnets ~}
        - name: tailscale-${tailnet.tailnet_name}
          image: ${container_registry}/tailscale/tailscale:stable
          command: ['/bin/sh', '-c']
          args:
            - >-
                export TS_HOSTNAME=$(hostname)-${tailnet.tailnet_name}-$VES_IO_SITENAME;
                /usr/local/bin/containerboot
          volumeMounts:
            - name: var-run-${tailnet.tailnet_name}
              mountPath: /var/run
          env:
            - name: TS_USERSPACE
              value: 'true'
            - name: TS_ACCEPT_DNS
              value: 'false'
            - name: TS_EXTRA_ARGS
              value: --shields-up%{ if tailnet.tailnet_advertise_tags != null && tailnet.tailnet_advertise_tags != "" } --advertise-tags=${tailnet.tailnet_advertise_tags}%{ endif }
            - name: TS_OUTBOUND_HTTP_PROXY_LISTEN
              value: 'localhost:${10550 + index}'
            - name: TS_KUBE_SECRET
              value: ''
            - name: TS_AUTHKEY
              value: '${tailnet.tailnet_key}'
%{ endfor ~}
      volumes:
%{ for tailnet in tailnets ~}
        - name: var-run-${tailnet.tailnet_name}
          emptyDir: {}
%{ endfor ~}